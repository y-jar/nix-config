// =================================STARTUP
// To run a shell command (with variables, pipes, etc.), use spawn-sh-at-startup:
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"

// Note: the desktop shell spawn (noctalia-shell or shelljar) is injected by
// default.nix based on usrSettings.{shelljar,noctalia}.enable.
spawn-at-startup "xwayland-satellite"
spawn-at-startup "blanket"
spawn-at-startup "pavucontrol"
spawn-at-startup "easyeffects"
// spawn-at-startup "wayle"
// enviroment sturff
environment {
    XDG_CURRENT_DESKTOP "niri"
}
// =================================WALL
spawn-at-startup "awww-daemon"
// SET wall
spawn-sh-at-startup "sleep 1 && random-wall"
