{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Decide which logo to use:
  "logo": {
    "source": "~/.config/fastfetch/logos-bin/jar.txt",
    "type": "file",
    "padding": {
      "top": 1,
      "right": 4,
    },
  },

  // Control how information is displayed:
  "display": {
    "separator": "➜ ",
    "color": {
      "keys": "38;2;79;88;126", // applies one of my favorite colors "#4F587E"
    },
  },

  // Specify which modules to display and their configuration:
  "modules": [
    // "title",
    // {
    //   "type": "separator",
    //   "string": "=",
    // },
    // --- Basic Stats ---
    {
      "type": "os",
      "key": "OS  ",
    },
    {
      "type": "kernel",
      "key": "KER ",
    },
    {
      "type": "uptime",
      "key": "UPT ",
    },
    {
      "type": "shell",
      "key": "SHL ",
    },
    // "break",

    // --- Description Section ---
    {
      "type": "separator",
      "string": "=",
    },
    {
      "type": "custom",
      "format": "\u001b[36m\u001b[3mA Jars Contain Within\u001b[0m",
    },
    {
      "type": "separator",
      "string": "=",
    },

    // --- Hardware Stats ---
    {
      "type": "cpu",
      "key": "CPU ",
    },
    {
      "type": "gpu",
      "key": "GPU ",
    },
    {
      "type": "memory",
      "key": "MEM ",
    },
    {
      "type": "disk",
      "key": "DSK ",
    },
    // "break",
    // {
    //   "type": "colors",
    //   "symbol": "block",
    // },
  ],
}
