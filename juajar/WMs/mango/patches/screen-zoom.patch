diff --git a/include/mango/manage/zoom.h b/include/mango/manage/zoom.h
new file mode 100644
index 00000000..d3731ac1
--- /dev/null
+++ b/include/mango/manage/zoom.h
@@ -0,0 +1,64 @@
+#ifndef MANGO_MANAGE_ZOOM_H
+#define MANGO_MANAGE_ZOOM_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "mango/common/types.h"
+
+struct wlr_output_state;
+
+/*
+ * Screen zoom: a compositor level magnifier for every output at once.
+ *
+ * How it works (short version):
+ *
+ *   in/out/set/toggle dispatchers move zoom_target between 1.0 and
+ *   config.zoom_max. Each rendered frame screen_zoom_update() eases
+ *   zoom_level toward zoom_target. When zoom_level > 1.0,
+ *   screen_zoom_render() takes a cursor anchored proportional viewport
+ *   of the already rendered scene buffer, draws it scaled up to the full
+ *   output, swapping that buffer into the pending output commit. While
+ *   zoom_level > 1.0, handle_output_frame keeps scheduling vblank paced
+ *   frames so the viewport keeps following the cursor.
+ *
+ * Everything is driven from handle_output_frame / mango_scene_output_commit
+ * in src/manage/monitor.c. There is no garbage at zoom_level == 1.0: the
+ * calls become no ops and the zoom swapchain is freed.
+ */
+
+/* True while any output should keep re-rendering (zoom or animation running). */
+bool screen_zoom_active(void);
+
+/* Advance the ease out animation one frame; frees the swapchain on the
+ * frame zoom_level settles back at 1.0. Called once per monitor frame. */
+void screen_zoom_update(void);
+
+/*
+ * Replace the scene rendered buffer inside *state with a magnified one
+ * (cursor anchored proportional viewport; the content under the pointer
+ * icon is exactly what the next click hits, at every zoom level).
+ *
+ * Must be called after wlr_scene_output_build_state() succeeded, before
+ * wlr_output_commit_state(). Returns true when the buffer was swapped
+ * (zoom_level > 1.0) so the caller can keep page flipping unteared; false
+ * means *state was left untouched and commits normally.
+ *
+ * Fails soft: on any allocation or format error it leaves *state as the
+ * plain scene render, so a commit is never dropped. */
+bool screen_zoom_render(struct Monitor *m, struct wlr_output_state *state);
+
+/* Binding entries: step, reset or pin the zoom target.
+ *
+ *   screen_zoom_in:    zoom_target += config.zoom_speed  (clamped 1..max)
+ *   screen_zoom_out:   zoom_target -= config.zoom_speed  (clamped 1..max)
+ *   screen_zoom_reset: zoom_target = 1.0
+ *   screen_zoom_set:   zoom_target = arg->f             (clamped 1..max)
+ *   screen_zoom_toggle: at rest -> config.zoom_max, else -> 1.0 */
+int32_t screen_zoom_in(const Arg *arg);
+int32_t screen_zoom_out(const Arg *arg);
+int32_t screen_zoom_reset(const Arg *arg);
+int32_t screen_zoom_set(const Arg *arg);
+int32_t screen_zoom_toggle(const Arg *arg);
+
+#endif
