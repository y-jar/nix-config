diff --git a/src/manage/zoom.c b/src/manage/zoom.c
new file mode 100644
index 00000000..bbc6367c
--- /dev/null
+++ b/src/manage/zoom.c
@@ -0,0 +1,381 @@
+#include "mango/manage/zoom.h"
+
+#include <math.h>
+#include <drm_fourcc.h>
+#include <wlr/render/allocator.h>
+#include <wlr/render/pass.h>
+#include <wlr/render/swapchain.h>
+#include <wlr/render/wlr_texture.h>
+#include <wlr/types/wlr_cursor.h>
+#include <wlr/types/wlr_output.h>
+#include <wlr/types/wlr_scene.h>
+
+#include "mango/common/log.h"
+#include "mango/common/server.h"
+#include "mango/config/parse.h"
+#include "mango/dispatch/bind.h"
+#include "mango/manage/monitor.h"
+
+/*
+ * Screen zoom internals.
+ *
+ * Zoom state lives per monitor (see struct Monitor): only the output under
+ * the pointer is magnified, other screens stay at 1.0 so they can be
+ * compared side by side, and each screen holds its own level until reset.
+ *
+ * Rendering pipeline recap, per monitor frame:
+ *
+ *   1. wlr_scene_output_build_state() renders the whole scene into a fresh
+ *      buffer (the "state" that will be committed).
+ *   2. screen_zoom_render() takes the cursor position, takes a cursor
+ *      anchored proportional viewport of 1 / zoom_level size and draws it
+ *      scaled up onto a buffer owned by the monitor's zoom swapchain,
+ *      bilinear filtered, on a black clear. The resulting buffer replaces
+ *      the scene buffer inside the pending output state.
+ *   3. wlr_output_commit_state() presents the (possibly swapped) buffer.
+ *
+ * The swapchain is rebuilt lazily whenever the output buffer size changes
+ * and is destroyed as soon as the zoom settles back at 1.0.
+ *
+ * Capture friendliness: while a zoomed monitor sits idle (no animation and
+ * no pointer movement seen) the normal frame skip logic stays enabled, so
+ * output captures (PipeWire share) are not handed a fresh frame every
+ * refresh. pointer activity is tracked through screen_zoom_mark_pointer_
+ * activity() and consumed by the frame skip check. */
+
+/* Monitor under the pointer; the zoom dispatch target. */
+static struct Monitor *zoom_hover_monitor(void) {
+	struct Monitor *m = monitor_at_point(server.cursor->x, server.cursor->y);
+	return m ? m : server.selected_monitor;
+}
+
+bool screen_zoom_busy(struct Monitor *m) {
+	return m && (m->zoom_animating || m->zoom_pointer_dirty);
+}
+
+bool screen_zoom_active_monitor(struct Monitor *m) {
+	return m && m->zoom_level > 1.0f;
+}
+
+void screen_zoom_destroy(struct Monitor *m) {
+	if (!m) {
+		return;
+	}
+	if (m->zoom_swapchain) {
+		wlr_swapchain_destroy(m->zoom_swapchain);
+		m->zoom_swapchain = NULL;
+		m->zoom_swapchain_width = 0U;
+		m->zoom_swapchain_height = 0U;
+	}
+}
+
+static void zoom_garbage_collect(struct Monitor *m) {
+	if (m->zoom_level > 1.0f || m->zoom_target > 1.0f || m->zoom_animating) {
+		return;
+	}
+	screen_zoom_destroy(m);
+}
+
+void screen_zoom_update(struct Monitor *m) {
+	if (!m || !m->zoom_animating) {
+		return;
+	}
+
+	/* Ease out: close most of the distance each frame, then settle. Plain
+	 * numbers, deliberately independent of the frame clock. Tuned
+	 * snappier than the upstream Zoom patch (0.15 per frame, creeping to
+	 * 0.002): 0.28 lands in roughly 16 frames at 60 Hz and the 0.005
+	 * threshold cuts the long end tail, which matters for scroll zoom
+	 * where each ratchet has to finish before the next notch reads. */
+	float diff = m->zoom_target - m->zoom_level;
+	if (fabsf(diff) <= 0.005f) {
+		m->zoom_level = m->zoom_target;
+		m->zoom_animating = false;
+	} else {
+		m->zoom_level += diff * 0.28f;
+	}
+
+	/* Free the swapchain only once the zoom fully settled back at 1.0 and
+	 * nothing is going to redraw through it. */
+	zoom_garbage_collect(m);
+}
+
+/*
+ * Clamp target into the valid 1.0 .. config.zoom_max window and set the
+ * monitor's zoom_target, then poke that monitor so the next animation step
+ * runs on a fresh frame instead of waiting for user input.
+ *
+ * Returns true when the target changed enough to need repaints. */
+static bool zoom_nudge_target(struct Monitor *m, float target) {
+	float upper = config.zoom_max > 1.0f ? config.zoom_max : 1.0f;
+	if (target < 1.0f) {
+		target = 1.0f;
+	} else if (target > upper) {
+		target = upper;
+	}
+
+	if (target == m->zoom_target) {
+		return false;
+	}
+
+	m->zoom_target = target;
+	m->zoom_animating = m->zoom_target != m->zoom_level;
+	if (m->wlr_output && m->wlr_output->enabled) {
+		wlr_output_schedule_frame(m->wlr_output);
+	}
+	return true;
+}
+
+int32_t screen_zoom_in(const Arg *arg) {
+	(void)arg;
+	struct Monitor *m = zoom_hover_monitor();
+	zoom_nudge_target(m, m->zoom_target + config.zoom_speed);
+	return 0;
+}
+
+int32_t screen_zoom_out(const Arg *arg) {
+	(void)arg;
+	struct Monitor *m = zoom_hover_monitor();
+	zoom_nudge_target(m, m->zoom_target - config.zoom_speed);
+	return 0;
+}
+
+int32_t screen_zoom_reset(const Arg *arg) {
+	(void)arg;
+	/* Reset is the guaranteed clean fallback: clear every screen, so a
+	 * monitor whose zoom persisted while the pointer lives on the other
+	 * one can not be stuck. */
+	struct Monitor *m;
+	wl_list_for_each(m, &server.monitors, link) {
+		zoom_nudge_target(m, 1.0f);
+	}
+	return 0;
+}
+
+int32_t screen_zoom_set(const Arg *arg) {
+	Arg val = {0};
+	if (arg)
+		val = *arg;
+	zoom_nudge_target(zoom_hover_monitor(), val.f);
+	return 0;
+}
+
+int32_t screen_zoom_toggle(const Arg *arg) {
+	(void)arg;
+	/* At rest (or resting on the way back) jump to full magnification,
+	 * otherwise return to 1.0. zoom_level follows via the animation. */
+	struct Monitor *m = zoom_hover_monitor();
+	if (m->zoom_target > 1.0f) {
+		zoom_nudge_target(m, 1.0f);
+	} else {
+		zoom_nudge_target(m, config.zoom_max);
+	}
+	return 0;
+}
+
+/*
+ * Pointer tracking for the capture friendly idle skip: while a zoomed
+ * monitor sits at rest, the frame skip logic is allowed again, so an
+ * output share stops absorbing full re-renders. Every pointer motion
+ * epoch marks the monitor under the pointer and pokes its output for a
+ * frame so the magnified view pans and the skip path does not deadlock
+ * on unscheduled frames.
+ *
+ * Returns true when a zoomed monitor was marked and poked. */
+bool screen_zoom_mark_pointer_activity(struct Monitor *m) {
+	if (!m || m->zoom_level <= 1.0f) {
+		return false;
+	}
+	m->zoom_pointer_dirty = true;
+	if (m->wlr_output && m->wlr_output->enabled) {
+		wlr_output_schedule_frame(m->wlr_output);
+	}
+	return true;
+}
+
+/*
+ * Make sure a swapchain matching the current output buffer size exists.
+ *
+ * Swapchains are created against server.allocator with the render format
+ * advertised by server.renderer for this output. On mode or scale changes
+ * the old swapchain is dropped and rebuilt from scratch.
+ *
+ * Returns the swapchain or NULL on failure; the caller then falls back to
+ * committing the plain scene buffer for this frame. */
+static struct wlr_swapchain *zoom_get_swapchain(struct Monitor *m) {
+	struct wlr_output *output = m->wlr_output;
+	struct wlr_allocator *alloc = server.allocator;
+	struct wlr_renderer *renderer = server.renderer;
+
+	if (!alloc || !renderer) {
+		return NULL;
+	}
+
+	if (m->zoom_swapchain &&
+		m->zoom_swapchain_width == (uint32_t)output->width &&
+		m->zoom_swapchain_height == (uint32_t)output->height) {
+		return m->zoom_swapchain;
+	}
+
+	const struct wlr_drm_format_set *formats =
+		wlr_renderer_get_texture_formats(renderer, alloc->buffer_caps);
+	uint32_t render_format = output->render_format;
+	if (render_format == DRM_FORMAT_INVALID) {
+		render_format = DRM_FORMAT_XRGB8888;
+	}
+	const struct wlr_drm_format *format =
+		wlr_drm_format_set_get(formats, render_format);
+	if (!format) {
+		mango_error(false, WLR_ERROR,
+					"screen zoom: no render format for output");
+		return NULL;
+	}
+
+	struct wlr_swapchain *swapchain =
+		wlr_swapchain_create(alloc, output->width, output->height, format);
+	if (!swapchain) {
+		mango_error(false, WLR_ERROR,
+					"screen zoom: swapchain allocation failed");
+		return NULL;
+	}
+
+	if (m->zoom_swapchain) {
+		wlr_swapchain_destroy(m->zoom_swapchain);
+	}
+	m->zoom_swapchain = swapchain;
+	m->zoom_swapchain_width = (uint32_t)output->width;
+	m->zoom_swapchain_height = (uint32_t)output->height;
+	return m->zoom_swapchain;
+}
+
+bool screen_zoom_render(struct Monitor *m, struct wlr_output_state *state) {
+	if (!m || m->zoom_level <= 1.0f) {
+		return false;
+	}
+
+	if (!m->wlr_output || !m->scene_output || !state->buffer) {
+		return false;
+	}
+
+	struct wlr_output *output = m->wlr_output;
+	struct wlr_renderer *renderer = server.renderer;
+
+	struct wlr_swapchain *swapchain = zoom_get_swapchain(m);
+	if (!swapchain) {
+		return false;
+	}
+
+	struct wlr_buffer *zoom_buf = wlr_swapchain_acquire(swapchain);
+	if (!zoom_buf) {
+		return false;
+	}
+
+	/* The scene buffer holds the finished frame; wrap it in a texture so
+	 * the zoom render pass can sample from it. */
+	struct wlr_texture *scene_tex =
+		wlr_texture_from_buffer(renderer, state->buffer);
+	if (!scene_tex) {
+		wlr_buffer_unlock(zoom_buf);
+		return false;
+	}
+
+	/* Viewport: 1 / zoom_level of the buffer, anchored to the pointer
+	 * (zoom_level means m->zoom_level below).
+	 *
+	 * The anchor is chosen so the cursor's own point maps back onto the
+	 * cursor's position on screen: content at cursor x must land at
+	 * (x - vx) * zoom == x, which solves to vx = x * (zoom - 1) / zoom.
+	 * That one property makes the pointer icon WYSIWYG: what sits under
+	 * the icon is exactly the point that receives the click, at every
+	 * zoom level and every pointer position. It also provably keeps the
+	 * viewport inside the buffer for 1 <= zoom when 0 <= cx <= width
+	 * (vx >= 0 and vx + vw <= width), so the viewport chases the pointer
+	 * proportionally at the edges instead of pinning; the clamps below
+	 * stay only as float rounding insurance.
+	 *
+	 * Buffer pixels, so cursor room coordinates are scaled by the output
+	 * scale first, and the monitor origin (m->m) is layout relative. */
+	int32_t width = output->width;
+	int32_t height = output->height;
+
+	float scale = output->scale > 0.0f ? output->scale : 1.0f;
+	/* Cursor clamped onto this monitor: with per monitor zoom the pointer
+	 * can be on a different screen while this one stays magnified, and the
+	 * clamped position keeps the viewport pinned instead of overshooting.
+	 * The anchor bounds hold for 0 <= cx <= width. */
+	float cx = (server.cursor->x - (double)m->m.x) * scale;
+	float cy = (server.cursor->y - (double)m->m.y) * scale;
+	if (cx < 0.0f) {
+		cx = 0.0f;
+	} else if (cx > (float)width) {
+		cx = (float)width;
+	}
+	if (cy < 0.0f) {
+		cy = 0.0f;
+	} else if (cy > (float)height) {
+		cy = (float)height;
+	}
+
+	float zoom_anchor = (m->zoom_level - 1.0f) / m->zoom_level;
+	float vx = cx * zoom_anchor;
+	float vy = cy * zoom_anchor;
+	float vw = (float)width / m->zoom_level;
+	float vh = (float)height / m->zoom_level;
+
+	if (vx < 0.0f) {
+		vx = 0.0f;
+	}
+	if (vy < 0.0f) {
+		vy = 0.0f;
+	}
+	if (vx + vw > (float)width) {
+		vx = (float)width - vw;
+	}
+	if (vy + vh > (float)height) {
+		vy = (float)height - vh;
+	}
+
+	/* Full buffer clip region: guards the rect draw and the texture draw
+	 * against any coordinate rounding touching the border. */
+	pixman_region32_t full;
+	pixman_region32_init_rect(&full, 0, 0, (unsigned int)width,
+							  (unsigned int)height);
+
+	struct wlr_render_pass *pass =
+		wlr_renderer_begin_buffer_pass(renderer, zoom_buf, NULL);
+	if (!pass) {
+		pixman_region32_fini(&full);
+		wlr_texture_destroy(scene_tex);
+		wlr_buffer_unlock(zoom_buf);
+		return false;
+	}
+
+	/* Opaque black so nothing leaks through the swapped buffer. */
+	wlr_render_pass_add_rect(
+		pass, &(struct wlr_render_rect_options){
+				  .box = {0, 0, width, height},
+				  .color = {.r = 0.0f, .g = 0.0f, .b = 0.0f, .a = 1.0f},
+				  .clip = &full,
+			  });
+
+	/* Sample the clamped viewport across the whole buffer, bilinear
+	 * filtered so magnification stays smooth instead of blocky. */
+	wlr_render_pass_add_texture(
+		pass, &(struct wlr_render_texture_options){
+				  .texture = scene_tex,
+				  .src_box = {vx, vy, vw, vh},
+				  .dst_box = {0, 0, width, height},
+				  .filter_mode = WLR_SCALE_FILTER_BILINEAR,
+				  .clip = &full,
+			  });
+
+	wlr_render_pass_submit(pass);
+	pixman_region32_fini(&full);
+	wlr_texture_destroy(scene_tex);
+
+	/* Swap the zoomed buffer in as the commit buffer and drop our own
+	 * reference; the output state holds its lock until commit. */
+	wlr_output_state_set_buffer(state, zoom_buf);
+	wlr_buffer_unlock(zoom_buf);
+	return true;
+}
