+
+	// While the screen zoom is active (rendering or settled), keep the
+	// pipeline alive at vblank pacing so the viewport keeps chasing the
+	// cursor and the animation glides, without a busy loop.
+	if (screen_zoom_active() && server.allow_frame_scheduling) {
+		wlr_output_schedule_frame(m->wlr_output);
