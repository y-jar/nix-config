diff --git a/include/mango/manage/zoom.h b/include/mango/manage/zoom.h
new file mode 100644
index 00000000..a92e8f1d
--- /dev/null
+++ b/include/mango/manage/zoom.h
@@ -0,0 +1,76 @@
+#ifndef MANGO_MANAGE_ZOOM_H
+#define MANGO_MANAGE_ZOOM_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "mango/common/types.h"
+
+struct wlr_output_state;
+
+/*
+ * Screen zoom: a compositor level magnifier for every output at once.
+ *
+ * How it works (short version):
+ *
+ *   Zoom state lives on struct Monitor: only the output under the pointer
+ *   is magnified, other screens stay at 1.0 and each screen holds its own
+ *   level until reset. in/out/set/toggle move the target monitor's
+ *   zoom_target between 1.0 and config.zoom_max. Each rendered frame
+ *   screen_zoom_update() eases zoom_level toward zoom_target. When
+ *   zoom_level > 1.0, screen_zoom_render() takes a cursor anchored
+ *   proportional viewport of the already rendered scene buffer, draws it
+ *   scaled up to the full output, swapping that buffer into the pending
+ *   output commit.
+ *
+ * Everything is driven from handle_output_frame / mango_scene_output_commit
+ * in src/manage/monitor.c. There is no garbage at zoom_level == 1.0: the
+ * calls become no ops and the zoom swapchain is freed.
+ */
+
+/* True while the monitor needs re-render driven by the zoom (animation
+ * running or pointer moved since the last commit). Used to disable the
+ * frame skip logic so a zoomed, ACTIVE screen re-renders each refresh,
+ * while an idle zoomed screen can fall back to normal skipping. */
+bool screen_zoom_busy(struct Monitor *m);
+
+/* True while this monitor is magnified (zoom_level > 1.0). */
+bool screen_zoom_active_monitor(struct Monitor *m);
+
+/* Tear down the monitor's zoom swapchain (output destroy / pump out). */
+void screen_zoom_destroy(struct Monitor *m);
+
+/* Pointer bookkeeping: while zoomed at rest, mark + poke the monitor so
+ * the magnified view pans and the skip path knows to render once. */
+bool screen_zoom_mark_pointer_activity(struct Monitor *m);
+
+/* Advance the ease out animation one frame; frees the swapchain on the
+ * frame zoom_level settles back at 1.0. Called once per monitor frame. */
+void screen_zoom_update(struct Monitor *m);
+
+/*
+ * Replace the scene rendered buffer inside *state with a magnified one
+ * (cursor anchored proportional viewport; the content under the pointer
+ * icon is exactly what the next click hits, at every zoom level).
+ *
+ * Must be called after wlr_scene_output_build_state() succeeded, before
+ * wlr_output_commit_state(). Returns true when the buffer was swapped
+ * (zoom_level > 1.0) so the caller can keep page flipping unteared; false
+ * means *state was left untouched and commits normally.
+ *
+ * Fails soft: on any allocation or format error it leaves *state as the
+ * plain scene render, so a commit is never dropped. */
+bool screen_zoom_render(struct Monitor *m, struct wlr_output_state *state);
+
+/* Binding entries: step, reset or pin the zoom target.
+ *
+ * in / out / set / toggle resolve the zoom target to the monitor under
+ * the pointer (per-screen zoom: other outputs keep their own level).
+ * reset clears every monitor's zoom in one go. */
+int32_t screen_zoom_in(const Arg *arg);
+int32_t screen_zoom_out(const Arg *arg);
+int32_t screen_zoom_reset(const Arg *arg);
+int32_t screen_zoom_set(const Arg *arg);
+int32_t screen_zoom_toggle(const Arg *arg);
+
+#endif
