diff --git a/include/mango/manage/stream_privacy.h b/include/mango/manage/stream_privacy.h
new file mode 100644
index 00000000..b981d5b6
--- /dev/null
+++ b/include/mango/manage/stream_privacy.h
@@ -0,0 +1,46 @@
+#ifndef __MANGO_MANAGE_STREAM_PRIVACY_H__
+#define __MANGO_MANAGE_STREAM_PRIVACY_H__ 1
+
+#include "mango/dispatch/bind.h"
+#include <stdint.h>
+
+/*
+ * Stream privacy (the "shield" feature): windows flagged shield_when_capture
+ * read as opaque black in output captures (PipeWire screen shares) while the
+ * user keeps seeing and interacting with them normally.
+ *
+ * Implementation split:
+ *   - wlroots (patched externally) routes every ext image capture source
+ *     frame event of an output through a compositor hook registered by
+ *     stream_privacy_monitor_register(): see
+ *     wlr_output_set_ext_capture_privacy().
+ *   - The hook (stream_privacy_render) blits the committed buffer into a
+ *     per-monitor privacy swapchain and overdraws the shield boxes of every
+ *     flagged client visible on that output; the capture sees the recomposed
+ *     buffer, the display pipeline is untouched.
+ *
+ * Session bookkeeping lives in src/manage/misc.c (the capture session
+ * tracker): each ext copy-capture session maps to an output and calls the
+ * add/remove handlers here so shared sessions decide when privacy frames
+ * are worth rendering. */
+
+/* Register the wlroots capture privacy hook for m's output. */
+void stream_privacy_monitor_register(struct Monitor *m);
+
+/* Drop the hook and free the privacy swapchain (output teardown). */
+void stream_privacy_monitor_unregister(struct Monitor *m);
+
+/* Called by the capture session tracker: an ext capture session started
+ * for this output (NULL for non-output sources, ignored). */
+void stream_privacy_session_add(struct Monitor *m);
+
+/* The tracked session ended; frees privacy state when the last session
+ * on the output stops. */
+void stream_privacy_session_remove(struct Monitor *m);
+
+/* Dispatcher: toggles shield_when_capture on the target client
+ * (focused window by default) and pokes the outputs so the change shows
+ * up in an active share on the next frame. */
+int32_t stream_privacy_dispatch(const Arg *arg);
+
+#endif
