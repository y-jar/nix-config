+struct wlr_box screen_zoom_map_box(struct Monitor *m, struct wlr_box box) {
+	if (!m || !m->wlr_output) {
+		return box;
+	}
+
+	struct wlr_output *output = m->wlr_output;
+	int32_t width = output->width;
+	int32_t height = output->height;
+	float scale = output->scale > 0.0f ? output->scale : 1.0f;
+
+	/* Layout points to buffer pixels of the plain (unzoomed) render:
+	 * same projection the pointer anchor uses, dropping any monitor
+	 * origin offset. */
+	float bx = ((float)box.x - (float)m->m.x) * scale;
+	float by = ((float)box.y - (float)m->m.y) * scale;
+	float bw = (float)box.width * scale;
+	float bh = (float)box.height * scale;
+
+	if (m->zoom_viewport_valid) {
+		/* Re-project through the viewport the magnified commit was
+		 * built from: content at viewport-space p lands at
+		 * (p - vp.origin) * zoom in the magnified buffer. */
+		float zoom = m->zoom_viewport_level;
+		if (zoom > 1.0f) {
+			bx = (bx - m->zoom_viewport_x) * zoom;
+			by = (by - m->zoom_viewport_y) * zoom;
+			bw = bw * zoom;
+			bh = bh * zoom;
+		}
+	}
+
+	/* Clip to the buffer: boxes hanging past the edges shrink to the
+	 * visible slice. An empty result simply drops out as w/h <= 0. */
+	float ex = (float)width;
+	float ey = (float)height;
+	float nx = bx < 0.0f ? 0.0f : bx;
+	float ny = by < 0.0f ? 0.0f : by;
+	float er = bx + bw > ex ? ex : bx + bw;
+	float eb = by + bh > ey ? ey : by + bh;
+	if (nx > er) {
+		nx = er;
+	}
+	if (ny > eb) {
+		ny = eb;
+	}
+
+	return (struct wlr_box){
+		.x = (int32_t)lroundf(nx),
+		.y = (int32_t)lroundf(ny),
+		.width = (int32_t)lroundf(er - nx),
+		.height = (int32_t)lroundf(eb - ny),
+	};
+}
