diff --git a/src/manage/stream_privacy.c b/src/manage/stream_privacy.c
new file mode 100644
index 00000000..d0184542
--- /dev/null
+++ b/src/manage/stream_privacy.c
@@ -0,0 +1,283 @@
+/*
+ * Stream privacy renderer: feeds ext output captures a frame in which
+ * shielded windows read as opaque black, while the display keeps showing
+ * real content (see include/mango/manage/stream_privacy.h for the
+ * overview).
+ *
+ * Per frame with an active capture session and at least one shielded
+ * visible window:
+ *   1. collect the shield cover boxes for this monitor (layout coords,
+ *      via client_shield_box())
+ *   2. map them into the committed buffer's coordinate space with
+ *      screen_zoom_map_box() (handles the output scale and, when this
+ *      frame was magnified, the very viewport the zoom render used)
+ *   3. blit the committed buffer into a privacy swapchain buffer and
+ *      fill each mapped box opaque black
+ *   4. hand the buffer to wlroots, which consumes it synchronously in
+ *      copy-capture frame copies and unlocks it right after
+ *
+ * Without a shielded window the hook returns NULL and the committed
+ * buffer passes through ungated: no privacy state is allocated and no
+ * extra rendering happens. */
+
+#include "mango/manage/stream_privacy.h"
+
+#include <drm_fourcc.h>
+#include <time.h>
+#include <wlr/render/allocator.h>
+#include <wlr/render/pass.h>
+#include <wlr/render/swapchain.h>
+#include <wlr/render/wlr_texture.h>
+#include <wlr/types/wlr_output.h>
+
+#include "mango/animation/client.h"
+#include "mango/common/log.h"
+#include "mango/common/server.h"
+#include "mango/manage/client.h"
+#include "mango/manage/monitor.h"
+#include "mango/manage/zoom.h"
+#include <wlr/interfaces/wlr_output.h>
+
+/* Collecting geometry is O(clients) and boxes stay stack sized; a bind
+ * storm with every visible window shielded is the documented ceiling. */
+#define STREAM_PRIVACY_MAX_BOXES 64
+
+static struct wlr_buffer *
+stream_privacy_render(struct wlr_output *output, struct wlr_buffer *committed,
+					  const struct timespec *when, void *data);
+
+static bool privacy_needs_work(struct Monitor *m) {
+	Client *c = NULL;
+	wl_list_for_each(c, &server.clients, link) {
+		if (c->shield_when_capture && !c->iskilling && VISIBLEON(c, m)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static void privacy_schedule_refresh(struct Monitor *m) {
+	/* Kick the output so a mid-share shield change, or the session
+	 * start/end that turned privacy on or off, is visible next frame
+	 * instead of waiting for the next natural repaint. */
+	if (m->wlr_output && m->wlr_output->enabled &&
+		privacy_needs_work(m)) {
+		wlr_output_update_needs_frame(m->wlr_output);
+	}
+}
+
+void stream_privacy_monitor_register(struct Monitor *m) {
+	if (!m || !m->wlr_output) {
+		return;
+	}
+	wlr_output_set_ext_capture_privacy(m->wlr_output, &stream_privacy_render,
+									   m);
+}
+
+void stream_privacy_monitor_unregister(struct Monitor *m) {
+	if (!m) {
+		return;
+	}
+	if (m->wlr_output) {
+		wlr_output_set_ext_capture_privacy(m->wlr_output, NULL, NULL);
+	}
+	if (m->privacy_swapchain) {
+		wlr_swapchain_destroy(m->privacy_swapchain);
+		m->privacy_swapchain = NULL;
+		m->privacy_swapchain_width = 0U;
+		m->privacy_swapchain_height = 0U;
+	}
+}
+
+void stream_privacy_session_add(struct Monitor *m) {
+	if (!m) {
+		return;
+	}
+	m->privacy_session_count++;
+	privacy_schedule_refresh(m);
+}
+
+void stream_privacy_session_remove(struct Monitor *m) {
+	if (!m) {
+		return;
+	}
+	if (m->privacy_session_count > 0) {
+		m->privacy_session_count--;
+	}
+	if (m->privacy_session_count <= 0) {
+		/* Nothing consumes the privacy buffers anymore: free the
+		 * swapchain so idle monitors do not carry GPU memory. */
+		wlr_swapchain_destroy(m->privacy_swapchain);
+		m->privacy_swapchain = NULL;
+		m->privacy_swapchain_width = 0U;
+		m->privacy_swapchain_height = 0U;
+	}
+	privacy_schedule_refresh(m);
+}
+
+static struct wlr_swapchain *privacy_get_swapchain(struct Monitor *m) {
+	struct wlr_output *output = m->wlr_output;
+	struct wlr_allocator *alloc = server.allocator;
+	struct wlr_renderer *renderer = server.renderer;
+
+	if (!alloc || !renderer) {
+		return NULL;
+	}
+
+	if (m->privacy_swapchain &&
+		m->privacy_swapchain_width == (uint32_t)output->width &&
+		m->privacy_swapchain_height == (uint32_t)output->height) {
+		return m->privacy_swapchain;
+	}
+
+	const struct wlr_drm_format_set *formats =
+		wlr_renderer_get_texture_formats(renderer, alloc->buffer_caps);
+	uint32_t render_format = output->render_format;
+	if (render_format == DRM_FORMAT_INVALID) {
+		render_format = DRM_FORMAT_XRGB8888;
+	}
+	const struct wlr_drm_format *format =
+		wlr_drm_format_set_get(formats, render_format);
+	if (!format) {
+		mango_error(false, WLR_ERROR,
+					"stream privacy: no render format for output");
+		return NULL;
+	}
+
+	struct wlr_swapchain *swapchain =
+		wlr_swapchain_create(alloc, output->width, output->height, format);
+	if (!swapchain) {
+		mango_error(false, WLR_ERROR,
+					"stream privacy: swapchain allocation failed");
+		return NULL;
+	}
+
+	if (m->privacy_swapchain) {
+		wlr_swapchain_destroy(m->privacy_swapchain);
+	}
+	m->privacy_swapchain = swapchain;
+	m->privacy_swapchain_width = (uint32_t)output->width;
+	m->privacy_swapchain_height = (uint32_t)output->height;
+	return m->privacy_swapchain;
+}
+
+static struct wlr_buffer *stream_privacy_render(struct wlr_output *output,
+												struct wlr_buffer *committed,
+												const struct timespec *when,
+												void *data) {
+	(void)when;
+
+	struct Monitor *m = data;
+	if (!m || m->iscleanuping || output->data != m || !m->wlr_output ||
+		m->wlr_output != output || !output->enabled ||
+		m->privacy_session_count <= 0) {
+		return NULL;
+	}
+
+	struct wlr_box boxes[STREAM_PRIVACY_MAX_BOXES];
+	uint32_t n_boxes = 0;
+
+	Client *c = NULL;
+	wl_list_for_each(c, &server.clients, link) {
+		if (!c->shield_when_capture || c->iskilling || !VISIBLEON(c, m)) {
+			continue;
+		}
+		struct wlr_box box;
+		if (!client_shield_box(c, &box)) {
+			continue;
+		}
+		/* Layout coordinates journey into the committed buffer's own
+		 * space: output scale first, zoom viewport second (zoom-aware,
+		 * see screen_zoom_map_box), then clipped to the buffer. */
+		struct wlr_box mapped = screen_zoom_map_box(m, box);
+		if (mapped.width <= 0 || mapped.height <= 0) {
+			continue;
+		}
+		if (n_boxes == STREAM_PRIVACY_MAX_BOXES) {
+			mango_error(false, WLR_DEBUG,
+						"stream privacy: more than %d shielded windows "
+						"on %s, tail windows stay visible in captures",
+						STREAM_PRIVACY_MAX_BOXES, output->name);
+			break;
+		}
+		boxes[n_boxes++] = mapped;
+	}
+
+	if (n_boxes == 0) {
+		return NULL;
+	}
+
+	struct wlr_swapchain *swapchain = privacy_get_swapchain(m);
+	if (!swapchain || !committed) {
+		return NULL;
+	}
+
+	struct wlr_buffer *target = wlr_swapchain_acquire(swapchain);
+	if (!target || target->width != committed->width ||
+		target->height != committed->height) {
+		/* Size change not observed yet: this frame passes through
+		 * unshielded, the swapchain rebuilds on the next hook call
+		 * (privacy_get_swapchain has never seen the new size). */
+		wlr_buffer_unlock(target);
+		return NULL;
+	}
+
+	struct wlr_texture *tex =
+		wlr_texture_from_buffer(server.renderer, committed);
+	if (!tex) {
+		wlr_buffer_unlock(target);
+		return NULL;
+	}
+
+	struct wlr_render_pass *pass =
+		wlr_renderer_begin_buffer_pass(server.renderer, target, NULL);
+	if (!pass) {
+		wlr_texture_destroy(tex);
+		wlr_buffer_unlock(target);
+		return NULL;
+	}
+
+	/* The full committed frame, opaque: it is the exact content the
+	 * display pipeline shows, just sampled into the capture-side
+	 * buffer (the rects go on top below). */
+	wlr_render_pass_add_texture(
+		pass, &(struct wlr_render_texture_options){
+				  .texture = tex,
+				  .src_box = {0, 0, (float)committed->width,
+							  (float)committed->height},
+				  .dst_box = {0, 0, (float)target->width,
+							  (float)target->height},
+				  .blend_mode = WLR_RENDER_BLEND_MODE_NONE,
+			  });
+
+	for (uint32_t i = 0; i < n_boxes; i++) {
+		wlr_render_pass_add_rect(
+			pass, &(struct wlr_render_rect_options){
+					  .box = {boxes[i].x, boxes[i].y, boxes[i].width,
+							  boxes[i].height},
+					  .color = {.r = 0.0f, .g = 0.0f, .b = 0.0f, .a = 1.0f},
+				  });
+	}
+
+	wlr_render_pass_submit(pass);
+	wlr_texture_destroy(tex);
+
+	return target;
+}
+
+int32_t stream_privacy_dispatch(const Arg *arg) {
+	struct Monitor *sel = server.selected_monitor;
+	Client *target = arg->tc ? arg->tc : (sel ? sel->sel : NULL);
+
+	if (!target) {
+		return 0;
+	}
+
+	target->shield_when_capture = !target->shield_when_capture;
+
+	/* Live update: an active share shows the box appear (or the window
+	 * stop being shielded) with the very next frame. */
+	privacy_schedule_refresh(target->mon);
+
+	return 0;
+}
